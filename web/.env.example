# --- Neon Postgres (Vercel Marketplace injects these) ---
# Pooled (-pooler host) for the serverless web app:
DATABASE_URL=
# Unpooled (direct) for drizzle-kit migrations:
DATABASE_URL_UNPOOLED=

# --- Clerk (Vercel Marketplace) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Cron auth (Vercel Cron sends this as a Bearer token) ---
CRON_SECRET=
