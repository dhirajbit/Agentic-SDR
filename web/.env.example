# --- Neon Postgres (Vercel Marketplace injects these) ---
# Pooled (-pooler host) for the serverless web app:
DATABASE_URL=
# Unpooled (direct) for drizzle-kit migrations:
DATABASE_URL_UNPOOLED=

# --- Clerk (Vercel Marketplace) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Cron auth (Vercel Cron sends this as a Bearer token) ---
CRON_SECRET=

# --- WhatsApp webhook (shared secret; the local worker uses the same value to
# register the OpenWA webhook, and this validates inbound posts) ---
WHATSAPP_WEBHOOK_SECRET=

# --- Hosted OpenWA gateway (so the dashboard can show the QR directly) ---
# Public base incl. /api, e.g. https://agentic-sdr-openwa.onrender.com/api
OPENWA_API_URL=
# Operator-role OpenWA API key (infra credential, not a tenant secret)
OPENWA_API_KEY=
