# Pick the active tenant. The repo loads tenants/<slug>/.env on top of this file.
AGENTIC_SDR_TENANT=abhiyanta-tech

# --- Defaults (overridable per-tenant in tenants/<slug>/.env) ---
APOLLO_BASE_URL=https://api.apollo.io/api/v1
APOLLO_API_KEY=
APOLLO_EMAIL_ACCOUNT_ID=
APOLLO_CAMPAIGN_ID=
APOLLO_DAILY_SEND_CAP=80
APOLLO_LEAD_CREDIT_RESERVE=500

# --- Cloud sync (Neon Postgres backing the Vercel web app) ---
# Pooled (-pooler) Neon connection string. Used by cloud_agent.py / cloud_sync.py.
NEON_DATABASE_URL=
# Tenant execution model for the worker: sdr_cycle (best-roadways) or claude (abhiyanta).
SDR_DRIVER=sdr_cycle

# --- WhatsApp via OpenWA (self-hosted gateway at ../OpenWA) ---
# OpenWA REST API base. Default is the local gateway (NestJS, port 2785) + /api prefix.
OPENWA_BASE_URL=http://localhost:2785/api
# Operator-role API key minted by the gateway (X-API-Key). See OpenWA /api/auth/api-keys.
OPENWA_API_KEY=
# Id of the QR-authorised WhatsApp session this tenant sends from.
OPENWA_SESSION_ID=
# Prepended to bare national numbers when building chat ids (India = 91).
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Max WhatsApp first-touches per day. Keep conservative — unofficial automation risks bans.
WHATSAPP_DAILY_SEND_CAP=30
